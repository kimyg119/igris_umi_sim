#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        custom token physxScene:solverType = "TGS"
        custom uint physxScene:timeStepsPerSecond = 240
    }

    def "Looks"
    {
        def Material "DeskWood"
        {
            token outputs:mdl:displacement.connect = </World/Looks/DeskWood/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/DeskWood/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/DeskWood/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/DeskWood/Preview.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:bump_factor = 0.5
                asset inputs:diffuse_texture = @./assets/textures/desk_wood_albedo.png@ (
                    colorSpace = "sRGB"
                )
                asset inputs:normalmap_texture = @./assets/textures/desk_wood_normal.png@ (
                    colorSpace = "raw"
                )
                float inputs:reflection_roughness_constant = 0.47
                float inputs:reflection_roughness_texture_influence = 1
                asset inputs:reflectionroughness_texture = @./assets/textures/desk_wood_roughness.png@ (
                    colorSpace = "raw"
                )
                float inputs:specular_level = 0.5
                token outputs:out
            }

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/DeskWood/PreviewTex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.47
                token outputs:surface
            }

            def Shader "PreviewST"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "PreviewTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./assets/textures/desk_wood_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/DeskWood/PreviewST.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "WallPaint"
        {
            token outputs:mdl:displacement.connect = </World/Looks/WallPaint/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/WallPaint/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/WallPaint/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/WallPaint/Preview.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:detail_bump_factor = 1
                asset inputs:detail_normalmap_texture = @./assets/textures/wall_stipple_normal.png@ (
                    colorSpace = "raw"
                )
                float2 inputs:detail_texture_scale = (4.8828125, 4.8828125)
                asset inputs:diffuse_texture = @./assets/textures/wall_paint_albedo.png@ (
                    colorSpace = "sRGB"
                )
                float inputs:reflection_roughness_constant = 0.82
                float inputs:specular_level = 0.35
                token outputs:out
            }

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/WallPaint/PreviewTex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.82
                token outputs:surface
            }

            def Shader "PreviewST"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "PreviewTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./assets/textures/wall_paint_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/WallPaint/PreviewST.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "FloorVinyl"
        {
            token outputs:mdl:displacement.connect = </World/Looks/FloorVinyl/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/FloorVinyl/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/FloorVinyl/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/FloorVinyl/Preview.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:diffuse_texture = @./assets/textures/floor_vinyl_albedo.png@ (
                    colorSpace = "sRGB"
                )
                float inputs:reflection_roughness_constant = 0.42
                float inputs:specular_level = 0.5
                token outputs:out
            }

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/FloorVinyl/PreviewTex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.42
                token outputs:surface
            }

            def Shader "PreviewST"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "PreviewTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./assets/textures/floor_vinyl_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/FloorVinyl/PreviewST.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "BlackSteel"
        {
            token outputs:mdl:displacement.connect = </World/Looks/BlackSteel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/BlackSteel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/BlackSteel/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/BlackSteel/Preview.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.018, 0.018, 0.019)
                float inputs:reflection_roughness_constant = 0.48
                float inputs:specular_level = 0.5
                token outputs:out
            }

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "Aluminium"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Aluminium/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Aluminium/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Aluminium/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/Aluminium/Preview.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.62, 0.63, 0.65)
                float inputs:metallic_constant = 1
                float inputs:reflection_roughness_constant = 0.38
                float inputs:specular_level = 0.5
                token outputs:out
            }

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.72)
                float inputs:metallic = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "FingerPad" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }

