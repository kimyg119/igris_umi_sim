<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="igris_c_right_arm" params="parent">

        <link name="Shoulder_Pitch_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Shoulder_Roll_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Shoulder_Yaw_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Elbow_Pitch_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Wrist_Yaw_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Wrist_Front_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Wrist_Back_Right_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>


        <joint name="23_Shoulder_Pitch_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Shoulder_Pitch_Right_Link"/>
            <origin xyz="4 5 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-4.1415" upper="2.0467" effort="0.0" velocity="0.0"/>
        </joint>
        <joint name="24_Shoulder_Roll_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Shoulder_Roll_Right_Link"/>
            <origin xyz="4 6 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-4.1415" upper="1.1744" effort="0.0" velocity="0.0"/>
        </joint>
        <joint name="25_Shoulder_Yaw_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Shoulder_Yaw_Right_Link"/>
            <origin xyz="5 1 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-2.5708" upper="2.5708" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="26_Elbow_Pitch_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Elbow_Pitch_Right_Link"/>
            <origin xyz="5 2 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-3.093" upper="1.087" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="27_Wrist_Yaw_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Wrist_Yaw_Right_Link"/>
            <origin xyz="5 3 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-2.5708" upper="2.5708" effort="0.0" velocity="0.0"/>
        </joint>
        <joint name="28_Wrist_Front_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Wrist_Front_Right_Link"/>
            <origin xyz="5 4 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-1.9821" upper="1.7571" effort="0.0" velocity="0.0"/>
        </joint>
        <joint name="29_Wrist_Back_Right" type="revolute">
            <parent link="base_link"/>
            <child link="Wrist_Back_Right_Link"/>
            <origin xyz="5 5 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-1.7571" upper="1.9821" effort="0.0" velocity="0.0"/>
        </joint>

    </xacro:macro>

</robot>