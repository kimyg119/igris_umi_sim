<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igris_c_motors">

<xacro:include filename="waist/igris_c_waist.xacro"/>

<link name="base_link">
    <visual>
        <origin xyz="5 5 0.0"/>
        <geometry>
            <box size="10 10 0.01"/>
        </geometry>

        <material name="base">
            <color rgba="0.1 0.7 0.2 0.7"/>
        </material>
    </visual>
</link>

<xacro:igris_c_waist parent="base_link"/> 

</robot>