<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="igris_c_left_leg" params="parent">

        <link name="Hip_Pitch_Left_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Hip_Roll_Left_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Hip_Yaw_Left_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Knee_Pitch_Left_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Ankle_Out_Left_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>
        <link name="Ankle_In_Left_Link">
            <visual>
                <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

                <geometry>
                    <cylinder radius="0.02" length="0.5"/>
                </geometry>

                <material name="random">
                    <color rgba="0.7 0.7 0.7 0.7"/>
                </material>
            </visual>
        </link>


        <joint name="4_Hip_Pitch_Left" type="revolute">
            <parent link="base_link"/>
            <child link="Hip_Pitch_Left_Link"/>
            <origin xyz="1 4 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-3.0584" upper="1.5233" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="5_Hip_Roll_Left" type="revolute">
            <parent link="base_link"/>
            <child link="Hip_Roll_Left_Link"/>
            <origin xyz="1 5 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-1.3314" upper="3.3550" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="6_Hip_Yaw_Left" type="revolute">
            <parent link="base_link"/>
            <child link="Hip_Yaw_Left_Link"/>
            <origin xyz="1 6 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-2.5708" upper="2.5708" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="7_Knee_Pitch_Left" type="revolute">
            <parent link="base_link"/>
            <child link="Knee_Pitch_Left_Link"/>
            <origin xyz="2 1 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-1.087" upper="3.2852" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="8_Ankle_Out_Left" type="revolute">
            <parent link="base_link"/>
            <child link="Ankle_Out_Left_Link"/>
            <origin xyz="2 2 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-1.7117" upper="1.6908" effort="0.0" velocity="0.0"/>
        </joint>

        <joint name="9_Ankle_In_Left" type="revolute">
            <parent link="base_link"/>
            <child link="Ankle_In_Left_Link"/>
            <origin xyz="2 3 1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-1.7679" upper="1.8133" effort="0.0" velocity="0.0"/>
        </joint>
    </xacro:macro>
</robot>