<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="igris_c_waist" params="parent">
    <link name="Waist_Yaw_Link">
        <visual>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

            <geometry>
                <cylinder radius="0.02" length="0.5"/>
            </geometry>

            <material name="random">
                <color rgba="0.7 0.7 0.7 0.7"/>
            </material>
        </visual>
    </link>
    <link name="Waist_Left_Link">
        <visual>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

            <geometry>
                <cylinder radius="0.02" length="0.5"/>
            </geometry>

            <material name="random">
                <color rgba="0.7 0.7 0.7 0.7"/>
            </material>
        </visual>
    </link>
    <link name="Waist_Right_Link">
        <visual>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>

            <geometry>
                <cylinder radius="0.02" length="0.5"/>
            </geometry>

            <material name="random">
                <color rgba="0.7 0.7 0.7 0.7"/>
            </material>
        </visual>
    </link>


    <joint name="1_Waist_Yaw" type="revolute">
        <parent link="base_link"/>
        <child link="Waist_Yaw_Link"/>

        <origin xyz="1 1 1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-2.5708" upper="2.5708" effort="0.0" velocity="0.0"/>
    </joint>

    <joint name="2_Waist_Left" type="revolute">
        <parent link="base_link"/>
        <child link="Waist_Left_Link"/>
        <origin xyz="1 2 1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.6667" upper="2.4382" effort="0.0" velocity="0.0"/>
    </joint>

    <joint name="3_Waist_Right" type="revolute">
        <parent link="base_link"/>
        <child link="Waist_Right_Link"/>
        <origin xyz="1 3 1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.6667" upper="2.4382" effort="0.0" velocity="0.0"/>
    </joint>
    </xacro:macro>
</robot>